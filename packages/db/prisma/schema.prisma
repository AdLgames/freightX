// Harbour — Prisma schema (§4 of the engineering brief, implemented verbatim as the base).
//
// Additions beyond the brief are each marked `// (NEW vs brief) reason`.
//
// Conventions:
//   * Table names are @@map'd to snake_case (and columns @map'd) so the hand-written RLS
//     policies and triggers in prisma/migrations/0002_rls_and_guards read naturally
//     (`organization_id`, `updated_at`, ...). Prisma model/field names stay as in the brief.
//   * Every tenant model carries `organizationId` and an index that starts with it. The
//     tenant allow-list used by the Prisma extension lives in src/tenancy.ts and the RLS
//     table list in migrations 0002+ (0003: customs_profiles) — test/migrations.test.ts keeps the
//     three in sync.
//   * All internal ids are `@db.Uuid` (NEW vs brief): Prisma's default for `String @default(uuid())`
//     is TEXT, which cannot be compared with `current_setting('app.current_org')::uuid` in the
//     RLS policies. External ids (Stripe, forwarder, HMRC measure SIDs, audit targetId) stay TEXT.
//   * Money is always Decimal (§3). Never Float.
//   * Enums are additive only; never rename a value in place (§4 migration rules).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Tenancy & identity ----------

model Organization {
  id                   String             @id @default(uuid()) @db.Uuid
  name                 String
  eoriNumber           String?            @map("eori_number") // encrypted at rest, validated on save (§5.6)
  vatNumber            String?            @map("vat_number") // encrypted at rest, validated against HMRC VAT API (§5.6)
  vatRegistered        Boolean            @default(false) @map("vat_registered")
  baseCurrency         String             @default("GBP") @map("base_currency")
  plan                 Plan               @default(FREE)
  stripeCustomerId     String?            @unique @map("stripe_customer_id")
  // M6 (NEW vs brief) Stripe Billing subscription state, written only by the webhook processor
  // (apps/web billing/events.server.ts). `plan` above is the EFFECTIVE plan; `subscriptionStatus`
  // is the Stripe status mapped to our enum. `billingEmail` is PII (§7.3): stored lower-cased,
  // never logged, never in audit metadata.
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  subscriptionStatus   SubscriptionStatus @default(NONE) @map("subscription_status")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  billingEmail         String?            @map("billing_email")
  planUpdatedAt        DateTime?          @map("plan_updated_at")
  // end M6
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  deletedAt            DateTime?          @map("deleted_at") // soft delete

  // M2 (NEW vs brief, migration 0008) — field encryption (§7.3, src/crypto.ts) and identity checks.
  // `eoriNumber` / `vatNumber` above hold ciphertext (`v1:<iv>:<tag>:<data>`, AAD = org id + field
  // name) under a per-organisation data key, itself stored wrapped by the master key here. The
  // last four characters are kept in clear for display only; never log either field.
  dataKeyCiphertext       String?            @map("data_key_ciphertext")
  eoriLast4               String?            @map("eori_last4")
  vatLast4                String?            @map("vat_last4")
  eoriVerificationStatus  VerificationStatus @default(UNVERIFIED) @map("eori_verification_status") // HMRC EORI checker (§5.6), set by the worker's eori-verify job
  eoriVerifiedAt          DateTime?          @map("eori_verified_at")
  vatVerificationStatus   VerificationStatus @default(UNVERIFIED) @map("vat_verification_status") // HMRC VAT checker (§5.6), set by the worker's vat-verify job
  vatVerifiedAt           DateTime?          @map("vat_verified_at")
  // M2 — Companies House gate (ADR-0015): stored for audit, only active ltd/plc/LLP will later see
  // trade finance. `companiesHouseNumber` null + `companiesHouseCheckedAt` set = "sole trader or
  // partnership" was chosen. Values are copied from the API response, never from the form.
  companiesHouseNumber    String?            @map("companies_house_number")
  companiesHouseStatus    String?            @map("companies_house_status")
  companyType             String?            @map("company_type")
  companiesHouseCheckedAt DateTime?          @map("companies_house_checked_at")
  companiesHouseName      String?            @map("companies_house_name")

  members            Membership[]
  invitations        Invitation[] // M2 (NEW vs brief) pending and historical invitations
  products           Product[]
  suppliers          Supplier[]
  quotes             Quote[]
  quoteLines         QuoteLine[] // (NEW vs brief) inverse of the denormalised QuoteLine.organizationId
  shipments          Shipment[]
  shipmentEvents     ShipmentEvent[] // (NEW vs brief) inverse of the denormalised ShipmentEvent.organizationId
  documents          Document[] // (NEW vs brief) inverse of Document.organizationId
  auditLogs          AuditLog[]
  customsProfile     CustomsProfile? // (NEW vs brief) 1:1 customs/payment routing settings (§6.1 Phase 2 preconditions)
  // M3 (ADR-0012): inverses of the denormalised organizationId on the supplier sub-entities
  pickupLocations    PickupLocation[]
  paymentTerms       PaymentTerms[]
  payoutMethods      PayoutMethod[]
  containers         Container[] // M9 (ADR-0017) inverse of Container.organizationId
  // M7 (ADR-0013): inverses of the denormalised organizationId on purchase orders
  purchaseOrders     PurchaseOrder[]
  purchaseOrderItems PurchaseOrderItem[]
  poCounters         PoCounter[]

  @@map("organizations")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String?
  mfaEnabled   Boolean  @default(false) @map("mfa_enabled")
  createdAt    DateTime @default(now()) @map("created_at")
  // M2 (NEW vs brief, migration 0008) — every session records the epoch it was created under;
  // bumping it (member removed, later: email change) invalidates all of the user's sessions on
  // their next request (§7.1 "rotated on privilege change").
  sessionEpoch Int      @default(0) @map("session_epoch")

  memberships       Membership[]
  invitationsSent   Invitation[] @relation("invitationsSent") // M2 (NEW vs brief) inverse of Invitation.invitedBy
  uploadedDocuments Document[]   @relation("uploadedDocuments") // (NEW vs brief) inverse of Document.uploadedBy
  verifiedDocuments Document[]   @relation("verifiedDocuments") // (NEW vs brief) inverse of Document.verifiedBy

  cdsAuthorityConfirmations CustomsProfile[] @relation("cdsAuthorityConfirmations") // (NEW vs brief) inverse of CustomsProfile.cdsAuthorityConfirmedBy

  @@map("users")
}

model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now()) @map("created_at") // (NEW vs brief) needed for "member since" and audit ordering

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId]) // (NEW vs brief) every tenant model has an index starting with organizationId
  @@map("memberships")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER

  @@map("role")
}

enum Plan {
  FREE
  STARTER
  PRO

  @@map("plan")
}

// M6 (NEW vs brief) Stripe subscription status mapped to our vocabulary (billing/events.server.ts
// owns the mapping). NONE = never subscribed. Additive only (§4 migration rules).
enum SubscriptionStatus {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  PAUSED

  @@map("subscription_status")
}

// end M6
// M2 (NEW vs brief, migration 0008) — result of the asynchronous HMRC EORI / VAT checks (§5.6).
// Additive only. PENDING = saved, job queued; ERROR = the checker could not be reached (retried).
enum VerificationStatus {
  UNVERIFIED
  PENDING
  VALID
  INVALID
  ERROR

  @@map("verification_status")
}

// M2 (NEW vs brief, migration 0008) — invitation to join an organisation (§7.2 "manage members").
// Tenant table with RLS. The raw token exists only in the email link (`/invite/accept?token=`);
// `tokenHash` = sha256(secret). `email` is stored lower-cased for the accept-time comparison and
// `emailHash` = sha256(email) so "is this address already invited?" never needs the address in a
// query plan or log. Expires 7 days after creation; `acceptedAt` / `revokedAt` close it.
model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  emailHash      String    @map("email_hash")
  role           Role      @default(MEMBER)
  invitedById    String    @map("invited_by_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  invitedBy    User         @relation("invitationsSent", fields: [invitedById], references: [id])

  @@index([organizationId, emailHash])
  @@index([organizationId, createdAt])
  @@map("invitations")
}

// (NEW vs brief) How import duty/VAT is paid at the border. Additive only (§4 migration rules):
// append new values, never rename or remove one — quotes snapshot this value.
//   OWN_DEFERMENT     the importer's own duty deferment account (DAN); CDS requires the importer to
//                     authorise the forwarder's EORI to use it (CustomsProfile.cdsAuthorityGranted)
//   BROKER_DEFERMENT  the forwarder pays through its own deferment account and re-invoices, plus a
//                     fee (engine input `brokerDeferment`) — the default for micro-importers
//   CDS_CASH_ACCOUNT  the importer pays from a CDS cash account before release
enum PaymentMethod {
  OWN_DEFERMENT
  BROKER_DEFERMENT
  CDS_CASH_ACCOUNT

  @@map("payment_method")
}

// (NEW vs brief) Per-organisation customs payment routing: postponed VAT accounting, deferment and
// the forwarder's deferment terms. Feeds engine inputs `vatPostponed` / `brokerDeferment` and the
// Phase 2 booking preconditions (§6.1, see README). 1:1 with Organization.
// DB rules (migration 0003): DAN format, OWN_DEFERMENT needs a DAN, fee bounds, a granted CDS
// authority needs a confirmation time, and `usePva` requires a VAT-registered organisation
// (trigger customs_profiles_pva_requires_vat).
model CustomsProfile {
  id                        String        @id @default(uuid()) @db.Uuid
  organizationId            String        @map("organization_id") @db.Uuid
  usePva                    Boolean       @default(false) @map("use_pva") // postponed VAT accounting; only for VAT-registered orgs (trigger)
  paymentMethod             PaymentMethod @default(BROKER_DEFERMENT) @map("payment_method")
  // 7-digit Deferment Approval Number. Sensitive like the EORI: encrypted at rest per §7.3 once the
  // field-encryption extension lands (the format CHECK in 0003 must then move to the app layer),
  // never logged, never in audit metadata.
  danNumber                 String?       @map("dan_number")
  danLimit                  Decimal?      @map("dan_limit") @db.Decimal(14, 2) // monthly deferment limit (GBP), user-entered
  cdsAuthorityGranted       Boolean       @default(false) @map("cds_authority_granted") // importer authorised the forwarder's EORI to use its DAN in CDS
  cdsAuthorityConfirmedAt   DateTime?     @map("cds_authority_confirmed_at")
  cdsAuthorityConfirmedById String?       @map("cds_authority_confirmed_by_id") @db.Uuid // who ticked the confirmation (audit)
  brokerDefermentFeePct     Decimal?      @map("broker_deferment_fee_pct") @db.Decimal(5, 2) // forwarder's fee on duty+VAT it defers, "2.50" = 2.5%; null = unknown
  brokerDefermentMinimumGbp Decimal?      @map("broker_deferment_minimum_gbp") @db.Decimal(14, 2) // forwarder's minimum fee per entry; null = unknown
  createdAt                 DateTime      @default(now()) @map("created_at")
  updatedAt                 DateTime      @updatedAt @map("updated_at")

  organization            Organization @relation(fields: [organizationId], references: [id])
  cdsAuthorityConfirmedBy User?        @relation("cdsAuthorityConfirmations", fields: [cdsAuthorityConfirmedById], references: [id])

  // organizationId is unique (1:1). Declared model-level so it also serves as the "index starting
  // with organizationId" every tenant model has (test/migrations.test.ts).
  @@unique([organizationId])
  @@map("customs_profiles")
}

// ---------- Auth & growth (not tenant-scoped) ----------

// (NEW vs brief) §7.1: magic-link tokens are single-use, 15-minute, and stored hashed. The raw
// token is only ever in the email link; `tokenHash` = sha256(token). `usedAt` enforces single use.
model MagicLinkToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  email     String
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  ip        String?

  @@index([email, createdAt]) // rate limiting: 5 link requests / hour / email (§7.1)
  @@index([expiresAt]) // (NEW vs brief, 0004) cleanup of expired tokens (README "Magic-link cleanup")
  @@map("magic_link_tokens")
}

// (NEW vs brief) Phase 0 gate is "50 email signups" (§2). `source` = which surface captured it
// (e.g. "calculator", "landing").
model EmailSignup {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  source    String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("email_signups")
}

// M6 (NEW vs brief) Stripe webhook idempotency (§6.4 "duplicates are no-ops"). One row per Stripe
// event id, inserted by POST /webhooks/stripe before the event is queued; a second delivery of the
// same id is a no-op. NOT tenant-scoped (the organisation is only known after processing) and never
// holds the payload — only its sha256 — so nothing here is PII. `processedAt` is set when the
// processor finished (applied or ignored); `error` holds the last processing failure.
model StripeEvent {
  id            String    @id // Stripe event id, "evt_..."
  type          String // e.g. "customer.subscription.updated"
  receivedAt    DateTime  @default(now()) @map("received_at")
  processedAt   DateTime? @map("processed_at")
  error         String?
  payloadSha256 String    @map("payload_sha256")

  @@index([processedAt, receivedAt]) // ops: unprocessed / failed events
  @@map("stripe_events")
}

// end M6

// ---------- Catalogue ----------

model Supplier {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  name            String // M3: display name, maintained by the app as tradingName ?? legalName
  countryCode     String    @map("country_code") // DEPRECATED (M3, ADR-0012): alias of countryOfIncorporation, written alongside it; remove after M4 (decisions-needed (w))
  defaultIncoterm Incoterm? @map("default_incoterm")
  createdAt       DateTime  @default(now()) @map("created_at") // (NEW vs brief) timestamps for every mutable row
  updatedAt       DateTime  @updatedAt @map("updated_at") // (NEW vs brief)

  // M3 (ADR-0012) legal entity: what a payments partner screens for KYB/AML. Migration 0007
  // backfills legalName from name and countryOfIncorporation from countryCode.
  legalName              String    @map("legal_name") // as registered
  tradingName            String?   @map("trading_name")
  registrationNumber     String?   @map("registration_number") // e.g. Unified Social Credit Code; not PII, not secret
  countryOfIncorporation String    @map("country_of_incorporation") // ISO 3166-1 alpha-2
  defaultCurrency        String?   @map("default_currency") // ISO 4217; pre-fills product currency
  archivedAt             DateTime? @map("archived_at") // M3: archive instead of delete (products/quotes may reference)

  organization    Organization     @relation(fields: [organizationId], references: [id])
  products        Product[]
  // M3 (ADR-0012) physical entities, payment terms and partner payout references
  pickupLocations PickupLocation[]
  paymentTerms    PaymentTerms?
  payoutMethods   PayoutMethod[]
  purchaseOrders  PurchaseOrder[] // M7 (ADR-0013)

  @@unique([id, organizationId]) // (NEW vs brief) target of the composite FK from products (keeps denormalised org ids consistent)
  @@index([organizationId])
  @@map("suppliers")
}

// ---------- M3 (ADR-0012): supplier sub-entities ----------
// Each carries a denormalised organizationId and a composite FK (supplier_id, organization_id) →
// suppliers(id, organization_id), so a row can never point at another tenant's supplier. RLS,
// CHECKs, the one-default-per-supplier partial index and grants are hand-written in 0007.

// Where goods are collected: drives the origin port (and later origin trucking) of a quote. Never
// the goods' origin for duty — that stays on Product.originCountry.
model PickupLocation {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  supplierId      String   @map("supplier_id") @db.Uuid
  name            String // e.g. "Shenzhen factory"
  addressLine1    String?  @map("address_line1")
  addressLine2    String?  @map("address_line2")
  city            String?
  region          String?
  postcode        String?
  country         String // ISO 3166-1 alpha-2
  closestPortCode String   @map("closest_port_code") // UN/LOCODE; CHECK ^[A-Z]{2}[A-Z0-9]{3}$ in 0007
  isDefault       Boolean  @default(false) @map("is_default") // at most one per supplier (partial unique index, 0007)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id])
  supplier       Supplier        @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Cascade)
  purchaseOrders PurchaseOrder[] // M7 (ADR-0013)

  @@unique([id, supplierId, organizationId]) // M7: target of the composite FK from purchase_orders — a PO's pickup location must belong to the PO's supplier and tenant
  @@index([organizationId])
  @@index([supplierId])
  @@map("pickup_locations")
}

// Additive only (§4 migration rules).
enum PaymentTermType {
  PREPAID
  NET
  DEPOSIT_BALANCE

  @@map("payment_term_type")
}

// Additive only.
enum BalanceTrigger {
  ON_SHIPMENT
  AGAINST_BILL_OF_LADING
  ON_ARRIVAL

  @@map("balance_trigger")
}

// One per supplier (overridable per quote later). depositPct is a percentage ("30.00" = 30%),
// matching the engine's percent convention. CHECKs in 0007: 0 ≤ depositPct ≤ 100, netDays ≥ 0,
// DEPOSIT_BALANCE needs depositPct + balanceTrigger, NET needs netDays.
model PaymentTerms {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  supplierId     String          @map("supplier_id") @db.Uuid
  termType       PaymentTermType @map("term_type")
  depositPct     Decimal?        @map("deposit_pct") @db.Decimal(5, 2)
  balanceTrigger BalanceTrigger? @map("balance_trigger")
  netDays        Int?            @map("net_days")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  supplier     Supplier     @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([supplierId])
  @@unique([supplierId, organizationId]) // Prisma requires the 1:1 relation's scalar fields to be unique together (supplierId alone already is)
  @@index([organizationId])
  @@map("payment_terms")
}

// Additive only.
enum PayoutPartner {
  AIRWALLEX

  @@map("payout_partner")
}

// Additive only.
enum PayoutMethodType {
  LOCAL
  SWIFT

  @@map("payout_method_type")
}

// Partner reference ONLY (§7.3, ADR-0012): the account number, routing code and account name go
// straight to the partner and are never stored or logged here. accountLast4 is a masked display
// value (CHECK: at most 4 characters, 0007). Schema only in M3 — no UI, no code writes it yet.
model PayoutMethod {
  id                   String           @id @default(uuid()) @db.Uuid
  organizationId       String           @map("organization_id") @db.Uuid
  supplierId           String           @map("supplier_id") @db.Uuid
  partner              PayoutPartner
  partnerBeneficiaryId String           @map("partner_beneficiary_id") // the partner's id for the beneficiary
  type                 PayoutMethodType
  currency             String // ISO 4217
  bankCountry          String           @map("bank_country") // ISO 3166-1 alpha-2
  bankName             String?          @map("bank_name")
  accountLast4         String?          @map("account_last4")
  verifiedAt           DateTime?        @map("verified_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  supplier     Supplier     @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([partner, partnerBeneficiaryId])
  @@index([organizationId])
  @@index([supplierId])
  @@map("payout_methods")
}

model Product {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  supplierId         String?   @map("supplier_id") @db.Uuid
  sku                String
  name               String
  hsCode             String    @map("hs_code") // 8 or 10 digits, validated against tariff (§5.2)
  hsCodeVerifiedAt   DateTime? @map("hs_code_verified_at") // null = user-entered, unverified
  originCountry      String    @map("origin_country") // ISO code; may differ from supplier country
  unitValue          Decimal   @map("unit_value") @db.Decimal(14, 4)
  currency           String // ISO 4217
  weightKg           Decimal   @map("weight_kg") @db.Decimal(10, 3)
  volumeCbm          Decimal   @map("volume_cbm") @db.Decimal(10, 4)
  unitsPerCarton     Int?      @map("units_per_carton")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  // M3 (catalogue): carton dimensions kept so volumeCbm can be recomputed; the official tariff
  // description captured at verification time; a preference hint from the lookup; archive flag.
  cartonLengthCm     Decimal?  @map("carton_length_cm") @db.Decimal(8, 2)
  cartonWidthCm      Decimal?  @map("carton_width_cm") @db.Decimal(8, 2)
  cartonHeightCm     Decimal?  @map("carton_height_cm") @db.Decimal(8, 2)
  hsDescription      String?   @map("hs_description") // official tariff description when hsCodeVerifiedAt was set
  preferenceEligible Boolean   @default(false) @map("preference_eligible") // informational: any 142 measure existed at lookup; the engine decides per origin
  archivedAt         DateTime? @map("archived_at") // archive instead of delete: quote lines reference products

  organization       Organization        @relation(fields: [organizationId], references: [id])
  // (NEW vs brief) composite FK (supplier_id, organization_id) → suppliers(id, organization_id):
  // a product can never point at another tenant's supplier, whatever the app layer does.
  supplier           Supplier?           @relation(fields: [supplierId, organizationId], references: [id, organizationId])
  quoteLines         QuoteLine[]
  purchaseOrderItems PurchaseOrderItem[] // M7 (ADR-0013)

  @@unique([organizationId, sku])
  @@unique([id, organizationId]) // (NEW vs brief) target of the composite FK from quote_lines
  @@index([organizationId])
  @@map("products")
}

// ---------- Quoting ----------

enum QuoteStatus {
  DRAFT
  INDICATIVE
  READY
  ACCEPTED
  EXPIRED
  CANCELLED

  @@map("quote_status")
}

enum Incoterm {
  EXW
  FCA
  FOB
  CFR
  CIF
  DAP
  DPU
  DDP

  @@map("incoterm")
}

enum Mode {
  SEA_LCL
  SEA_FCL
  AIR
  ROAD
  RAIL

  @@map("mode")
}

model Quote {
  id               String      @id @default(uuid()) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  status           QuoteStatus @default(DRAFT)
  incoterm         Incoterm
  mode             Mode
  originCountry    String      @map("origin_country")
  originPort       String?     @map("origin_port") // UN/LOCODE
  destinationPort  String?     @map("destination_port") // UN/LOCODE
  deliveryPostcode String?     @map("delivery_postcode")

  // Snapshotted inputs (nothing here is a live reference)
  fxRate        Decimal  @map("fx_rate") @db.Decimal(14, 6) // supplier ccy → GBP (primary snapshot)
  fxSource      String   @map("fx_source") // "HMRC_MONTHLY" | "ECB" | "MANUAL"
  fxDate        DateTime @map("fx_date")
  fxSnapshots   Json     @map("fx_snapshots") // (NEW vs brief) every FX snapshot used, keyed by currency — engine QuoteResult.fxSnapshots (multi-currency quotes)
  rateSource    String   @map("rate_source") // "SEARATES" | "RATE_SHEET_V3" | "MANUAL"
  rateFetchedAt DateTime @map("rate_fetched_at")
  validUntil    DateTime @map("valid_until") // freight rate expiry

  // Aggregates in GBP, computed from lines
  goodsValueGbp        Decimal        @map("goods_value_gbp") @db.Decimal(14, 2)
  freightCost          Decimal        @map("freight_cost") @db.Decimal(14, 2)
  freightToBorderGbp   Decimal        @map("freight_to_border_gbp") @db.Decimal(14, 2) // (NEW vs brief) §5.3 dutiable leg — engine QuoteTotals.freightToBorderGbp
  freightPostBorderGbp Decimal        @map("freight_post_border_gbp") @db.Decimal(14, 2) // (NEW vs brief) §5.3 VAT-base-only leg — engine QuoteTotals.freightPostBorderGbp
  originFees           Decimal        @map("origin_fees") @db.Decimal(14, 2)
  destinationFees      Decimal        @map("destination_fees") @db.Decimal(14, 2)
  insurancePremium     Decimal        @default(0) @map("insurance_premium") @db.Decimal(14, 2)
  customsValue         Decimal        @map("customs_value") @db.Decimal(14, 2) // not "CIF" — see §5.3
  totalDuty            Decimal        @map("total_duty") @db.Decimal(14, 2)
  totalVat             Decimal        @map("total_vat") @db.Decimal(14, 2)
  vatRecoverable       Boolean        @map("vat_recoverable") // postponed VAT accounting
  platformFee          Decimal        @map("platform_fee") @db.Decimal(14, 2)
  totalLandedCost      Decimal        @map("total_landed_cost") @db.Decimal(14, 2) // incl. VAT
  totalLandedCostExVat Decimal        @map("total_landed_cost_ex_vat") @db.Decimal(14, 2) // the number VAT-registered users care about
  supplierBorneDuty    Decimal        @default(0) @map("supplier_borne_duty") @db.Decimal(14, 2) // (NEW vs brief) DDP: duty the supplier bears, informational — engine QuoteTotals.supplierBorneDuty
  supplierBorneVat     Decimal        @default(0) @map("supplier_borne_vat") @db.Decimal(14, 2) // (NEW vs brief) DDP: VAT the supplier bears — engine QuoteTotals.supplierBorneVat
  apportionmentBasis   String         @map("apportionment_basis") // (NEW vs brief) §5.4 "store the basis on the quote" — "SEA_WEIGHT_OR_MEASURE" | "AIR_VOLUMETRIC_6000"
  // engine calcVersion 1.1 outputs. Defaults keep migration 0003 additive: quotes
  // computed before 1.1 read as "not postponed, nothing extra" (their calcVersion says so).
  vatPostponed         Boolean        @default(false) @map("vat_postponed") // (NEW vs brief) engine QuoteTotals.vatPostponed — PVA in effect, VAT not paid at the border
  borderOutlay         Decimal        @default(0) @map("border_outlay") @db.Decimal(14, 2) // (NEW vs brief) engine QuoteTotals.borderOutlay — duty (+ VAT unless postponed) payable at the border; cash, not cost
  assistsGbp           Decimal        @default(0) @map("assists_gbp") @db.Decimal(14, 2) // (NEW vs brief) engine QuoteTotals.assistsGbp — tooling/moulds etc. added to customs value
  financingFee         Decimal        @default(0) @map("financing_fee") @db.Decimal(14, 2) // (NEW vs brief) engine QuoteTotals.financingFee — broker deferment fee
  inlandVatAdjustment  Decimal        @default(0) @map("inland_vat_adjustment") @db.Decimal(14, 2) // (NEW vs brief) engine QuoteTotals.inlandVatAdjustment — VAT-base padding, not landed cost
  paymentMethod        PaymentMethod? @map("payment_method") // (NEW vs brief) routing in force when computed — a snapshot of CustomsProfile.paymentMethod, not a reference
  // M4 (migration 0011): the builder's inputs as entered (product ids, quantities, flags, decimal
  // strings) so a DRAFT can be reopened in the builder. Never read for money: every figure comes
  // from the snapshot columns above. Null for quotes not created by the builder.
  builderInput         Json?          @map("builder_input")
  // M7 (ADR-0013, migration 0012): the purchase order this quote prices, when it was built from
  // one ("Get freight quote"). Optional — quotes without a PO stay possible. At most one ACCEPTED
  // quote per PO (partial unique index quotes_one_accepted_per_po, hand-written in 0012).
  purchaseOrderId      String?        @map("purchase_order_id") @db.Uuid

  warnings    Json // array of {code, message} e.g. ADD_APPLIES, HS_UNVERIFIED
  calcVersion String    @map("calc_version") // engine version that produced this quote
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id])
  lines         QuoteLine[]
  shipment      Shipment?
  documents     Document[] // (NEW vs brief, M5) inverse of Document.quoteId — documents attached before a shipment exists
  // M7: composite FK — a quote can only be linked to its own tenant's purchase order. Restrict:
  // purchase orders are cancelled, never deleted, once a quote references them.
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId]) // (NEW vs brief) target of composite FKs from quote_lines and shipments
  @@index([organizationId, status])
  @@index([organizationId, validUntil]) // (NEW vs brief) hourly expiry job (§5.8) scans by validUntil
  @@index([organizationId, purchaseOrderId]) // M7: "quotes for this purchase order"
  @@map("quotes")
}

model QuoteLine {
  id                              String   @id @default(uuid()) @db.Uuid
  organizationId                  String   @map("organization_id") @db.Uuid // (NEW vs brief) denormalised for RLS
  quoteId                         String   @map("quote_id") @db.Uuid
  productId                       String   @map("product_id") @db.Uuid
  quantity                        Int
  // Snapshots
  hsCode                          String   @map("hs_code")
  originCountry                   String   @map("origin_country")
  unitValue                       Decimal  @map("unit_value") @db.Decimal(14, 4)
  currency                        String
  unitValueGbp                    Decimal  @map("unit_value_gbp") @db.Decimal(14, 4)
  lineGoodsValueGbp               Decimal  @map("line_goods_value_gbp") @db.Decimal(14, 2)
  lineWeightKg                    Decimal  @map("line_weight_kg") @db.Decimal(10, 3)
  lineVolumeCbm                   Decimal  @map("line_volume_cbm") @db.Decimal(10, 4)
  chargeableWeight                Decimal  @map("chargeable_weight") @db.Decimal(14, 4) // (NEW vs brief) §5.4 apportionment share basis — engine LineResult.chargeableWeight
  // Tariff result
  tariffMeasureId                 String?  @map("tariff_measure_id") // HMRC measure SID we applied
  dutyType                        String   @map("duty_type") // "AD_VALOREM" | "SPECIFIC" | "COMPOUND" | "NONE"
  dutyRatePct                     Decimal? @map("duty_rate_pct") @db.Decimal(7, 4)
  dutySpecific                    Json?    @map("duty_specific") // {amount, unit, per} for £/kg etc.
  preferenceClaimed               Boolean  @default(false) @map("preference_claimed")
  addRatePct                      Decimal? @map("add_rate_pct") @db.Decimal(7, 4) // anti-dumping, if any
  vatRatePct                      Decimal  @map("vat_rate_pct") @db.Decimal(5, 2) // 20 / 5 / 0
  // Allocations (freight apportioned by chargeable weight — §5.4)
  allocatedFreightGbp             Decimal  @map("allocated_freight_gbp") @db.Decimal(14, 2)
  allocatedFreightToBorderGbp     Decimal  @map("allocated_freight_to_border_gbp") @db.Decimal(14, 2) // (NEW vs brief) §5.3 split — engine LineResult.allocatedFreightToBorderGbp
  allocatedFreightPostBorderGbp   Decimal  @map("allocated_freight_post_border_gbp") @db.Decimal(14, 2) // (NEW vs brief) §5.3 split
  allocatedOriginFeesGbp          Decimal  @map("allocated_origin_fees_gbp") @db.Decimal(14, 2) // (NEW vs brief) per-line share of shipment-level origin fees
  allocatedDestinationFeesGbp     Decimal  @map("allocated_destination_fees_gbp") @db.Decimal(14, 2) // (NEW vs brief) per-line share of destination fees
  allocatedInsuranceGbp           Decimal  @map("allocated_insurance_gbp") @db.Decimal(14, 2) // (NEW vs brief) per-line share of insurance premium
  allocatedPlatformFeeGbp         Decimal  @map("allocated_platform_fee_gbp") @db.Decimal(14, 2) // (NEW vs brief) per-line share of platform fee
  assistsGbp                      Decimal  @default(0) @map("assists_gbp") @db.Decimal(14, 2) // (NEW vs brief) calcVersion 1.1 — engine LineResult.assistsGbp
  allocatedFinancingFeeGbp        Decimal  @default(0) @map("allocated_financing_fee_gbp") @db.Decimal(14, 2) // (NEW vs brief) calcVersion 1.1 — per-line share of the broker deferment fee
  allocatedInlandVatAdjustmentGbp Decimal  @default(0) @map("allocated_inland_vat_adjustment_gbp") @db.Decimal(14, 2) // (NEW vs brief) calcVersion 1.1 — per-line share of the VAT-base inland adjustment
  lineCustomsValueGbp             Decimal  @map("line_customs_value_gbp") @db.Decimal(14, 2)
  lineDutyGbp                     Decimal  @map("line_duty_gbp") @db.Decimal(14, 2)
  lineVatGbp                      Decimal  @map("line_vat_gbp") @db.Decimal(14, 2)
  supplierBorneDutyGbp            Decimal  @default(0) @map("supplier_borne_duty_gbp") @db.Decimal(14, 2) // (NEW vs brief) DDP, informational — engine LineResult.supplierBorneDutyGbp
  supplierBorneVatGbp             Decimal  @default(0) @map("supplier_borne_vat_gbp") @db.Decimal(14, 2) // (NEW vs brief) DDP, informational
  lineLandedCostExVatGbp          Decimal  @map("line_landed_cost_ex_vat_gbp") @db.Decimal(14, 2) // (NEW vs brief) line total ex VAT — engine LineResult.lineLandedCostExVatGbp
  lineLandedCostGbp               Decimal  @map("line_landed_cost_gbp") @db.Decimal(14, 2) // (NEW vs brief) line total incl. VAT
  landedCostPerUnit               Decimal  @map("landed_cost_per_unit") @db.Decimal(14, 4)
  landedCostPerUnitIncVat         Decimal  @map("landed_cost_per_unit_inc_vat") @db.Decimal(14, 4) // (NEW vs brief) engine LineResult.landedCostPerUnitIncVat

  organization Organization @relation(fields: [organizationId], references: [id]) // (NEW vs brief)
  // (NEW vs brief) composite FKs carry organization_id so a line can never reference a quote or
  // product from another tenant; the denormalised column is guaranteed consistent by Postgres.
  quote        Quote        @relation(fields: [quoteId, organizationId], references: [id, organizationId], onDelete: Cascade)
  product      Product      @relation(fields: [productId, organizationId], references: [id, organizationId])

  @@index([organizationId]) // (NEW vs brief) RLS / tenant scoping
  @@index([quoteId])
  @@map("quote_lines")
}

// ---------- M7 (ADR-0013): purchase orders ----------
// What the importer agreed to buy: supplier, products, quantities, unit prices and payment terms.
// Money is in the PO CURRENCY (unit costs Decimal(14,4), totals Decimal(14,2)); nothing here is in
// GBP — FX happens on the quote built from the PO. Rules in migration 0012 (hand-written part):
//   * po_number `PO-YYYY-NNN`, unique per organisation, from po_counters (one row per org + year)
//   * status transitions checked by trigger: DRAFT→ISSUED→IN_PRODUCTION→READY_TO_SHIP→SHIPPED→CLOSED,
//     ISSUED→READY_TO_SHIP (production may be skipped), any status but CLOSED/CANCELLED→CANCELLED
//   * once a PO is not DRAFT only status, the paid-at/due-at dates, notes and updated_at may change;
//     its items are frozen (same to_jsonb technique as the accepted-quote trigger, 0002)
//   * payment is NOT a status: deposit/balance amounts are computed from the supplier's PaymentTerms
//     when the PO is issued and frozen; the paid-at dates are set by the user (later: the payments
//     partner's webhook, ADR-0016)

// Additive only (§4 migration rules).
enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  IN_PRODUCTION
  READY_TO_SHIP
  SHIPPED
  CLOSED
  CANCELLED

  @@map("purchase_order_status")
}

model PurchaseOrder {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  poNumber          String              @map("po_number") // PO-2026-001; CHECK format in 0012
  supplierId        String              @map("supplier_id") @db.Uuid
  pickupLocationId  String?             @map("pickup_location_id") @db.Uuid // origin port for "get freight quote"
  status            PurchaseOrderStatus @default(DRAFT)
  currency          String // ISO 4217, copied from the supplier's default and editable while DRAFT
  incoterm          Incoterm
  totalGoodsValue   Decimal             @default(0) @map("total_goods_value") @db.Decimal(14, 2) // sum of item line totals, PO currency; frozen on issue
  depositPct        Decimal?            @map("deposit_pct") @db.Decimal(5, 2) // percent convention ("30.00" = 30%); set on issue from PaymentTerms
  depositAmount     Decimal?            @map("deposit_amount") @db.Decimal(14, 2)
  depositDueAt      DateTime?           @map("deposit_due_at")
  depositPaidAt     DateTime?           @map("deposit_paid_at")
  balanceAmount     Decimal?            @map("balance_amount") @db.Decimal(14, 2)
  balanceTrigger    BalanceTrigger?     @map("balance_trigger") // copied from PaymentTerms on issue (DEPOSIT_BALANCE)
  balanceDueAt      DateTime?           @map("balance_due_at")
  balancePaidAt     DateTime?           @map("balance_paid_at")
  expectedShipMonth DateTime?           @map("expected_ship_month") @db.Date // first day of the month (CHECK); the HMRC rate month the quote should use once published
  issuedAt          DateTime?           @map("issued_at")
  notes             String?
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  organization   Organization        @relation(fields: [organizationId], references: [id])
  // Composite FKs: the supplier and the pickup location must belong to this tenant, and the
  // pickup location to this supplier (three-column FK).
  supplier       Supplier            @relation(fields: [supplierId, organizationId], references: [id, organizationId])
  pickupLocation PickupLocation?     @relation(fields: [pickupLocationId, supplierId, organizationId], references: [id, supplierId, organizationId])
  items          PurchaseOrderItem[]
  quotes         Quote[]

  @@unique([organizationId, poNumber])
  @@unique([id, organizationId]) // target of the composite FKs from purchase_order_items and quotes
  @@index([organizationId, status])
  @@index([supplierId])
  @@map("purchase_orders")
}

// One product line of a PO. SKU and name are snapshots (the catalogue may change); weight, volume,
// HS code and origin are deliberately NOT frozen here — they are snapshotted onto QuoteLine when a
// quote is built (ADR-0013). Frozen once the PO leaves DRAFT (trigger, 0012).
model PurchaseOrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  organizationId  String  @map("organization_id") @db.Uuid
  purchaseOrderId String  @map("purchase_order_id") @db.Uuid
  productId       String  @map("product_id") @db.Uuid
  position        Int // display order, 0-based
  quantity        Int
  unitCost        Decimal @map("unit_cost") @db.Decimal(14, 4) // PO currency
  lineTotal       Decimal @map("line_total") @db.Decimal(14, 2) // round2(quantity × unitCost)
  sku             String // snapshot
  name            String // snapshot

  organization  Organization  @relation(fields: [organizationId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  product       Product       @relation(fields: [productId, organizationId], references: [id, organizationId])

  @@index([organizationId])
  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

// Per-organisation, per-year PO number counter. `next` is the next NNN to hand out; the create
// transaction does `INSERT ... ON CONFLICT DO UPDATE SET next = next + 1 RETURNING` so concurrent
// creates serialise on the row and never share a number. Tenant table (RLS) like the others.
model PoCounter {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  year           Int
  next           Int    @default(1)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, year])
  @@map("po_counters")
}

// ---------- Execution (Phase 2) ----------

enum ShipmentStatus {
  PENDING_DOCS
  PENDING_BOOKING
  BOOKED
  DISPATCHED
  IN_TRANSIT
  AT_DESTINATION
  CUSTOMS
  CLEARED
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  CANCELLED

  @@map("shipment_status")
}

model Shipment {
  id                    String         @id @default(uuid()) @db.Uuid
  organizationId        String         @map("organization_id") @db.Uuid // denormalised for RLS
  quoteId               String?        @unique @map("quote_id") @db.Uuid // M9: optional — a container can be tracked before any quote exists (ADR-0017); nullable-unique
  status                ShipmentStatus @default(PENDING_DOCS)
  forwarderId           String?        @map("forwarder_id") // which partner
  forwarderRef          String?        @map("forwarder_ref")
  containerNo           String?        @map("container_no")
  vesselOrFlight        String?        @map("vessel_or_flight")
  etd                   DateTime?
  eta                   DateTime?
  atd                   DateTime?
  ata                   DateTime?
  bookingIdempotencyKey String?        @unique @map("booking_idempotency_key") // §6.2
  lastPolledAt          DateTime?      @map("last_polled_at")
  // M9 (ADR-0017) — Phase-1 tracking fields. All optional so the migration is additive.
  reference             String? // user label, e.g. "Autumn stock — Yantian"
  masterBillNumber      String?        @map("master_bill_number")
  originLocode          String?        @map("origin_locode") // UN/LOCODE (Port.locode when known)
  destinationLocode     String?        @map("destination_locode") // UN/LOCODE; drives the vessel poll distance
  trackingProvider      String?        @map("tracking_provider") // MilestoneProvider.id, e.g. "terminal49"; null = manual only
  trackingRequestRef    String?        @map("tracking_request_ref") // provider's subscription id (never a secret)
  trackingSubscribedAt  DateTime?      @map("tracking_subscribed_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id])
  // (NEW vs brief) composite FK: a shipment can only be booked against its own tenant's quote.
  quote        Quote?          @relation(fields: [quoteId, organizationId], references: [id, organizationId])
  documents    Document[]
  events       ShipmentEvent[]
  containers   Container[] // M9

  @@unique([id, organizationId]) // (NEW vs brief) target of composite FKs from shipment_events and documents
  @@unique([quoteId, organizationId]) // (NEW vs brief) Prisma requires the 1:1 relation's scalar fields to be unique together (quoteId alone already is)
  @@index([organizationId, status])
  @@map("shipments")
}

// Append-only timeline (UPDATE/DELETE rejected by trigger in migration 0002).
model ShipmentEvent {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid // (NEW vs brief) denormalised for RLS so the policy needs no join
  shipmentId      String          @map("shipment_id") @db.Uuid
  source          String // "FORWARDER_WEBHOOK" | "POLL" | "MANUAL" | "SYSTEM"
  providerEventId String?         @map("provider_event_id") // idempotency — unique per source
  eventType       String          @map("event_type") // vessel_departed, customs_cleared...
  statusAfter     ShipmentStatus? @map("status_after")
  occurredAt      DateTime        @map("occurred_at")
  receivedAt      DateTime        @default(now()) @map("received_at")
  payload         Json // raw, redacted of PII
  // M9 (ADR-0017) — milestones live here, not in a separate TrackingEvent table. All optional.
  containerId     String?         @map("container_id") @db.Uuid
  locationLocode  String?         @map("location_locode")
  locationName    String?         @map("location_name")
  latitude        Decimal?        @db.Decimal(9, 6) // coordinates, not money
  longitude       Decimal?        @db.Decimal(9, 6)
  vesselImo       String?         @map("vessel_imo")
  payloadSha256   String?         @map("payload_sha256") // sha256 of the provider payload (dedupe forensics)

  organization Organization @relation(fields: [organizationId], references: [id]) // (NEW vs brief)
  // (NEW vs brief) composite FK keeps the denormalised organization_id consistent with the shipment.
  shipment     Shipment     @relation(fields: [shipmentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  // M9: composite FK — an event can only point at a container of the same tenant.
  container    Container?   @relation(fields: [containerId, organizationId], references: [id, organizationId])

  // M9: idempotency is per organisation — one provider event fans out to every tenant tracking
  // that container number (ADR-0017), so (source, providerEventId) alone would block the second.
  @@unique([organizationId, source, providerEventId])
  @@index([organizationId]) // (NEW vs brief) RLS / tenant scoping
  @@index([shipmentId, occurredAt])
  @@index([containerId]) // M9
  @@map("shipment_events")
}

// M9 (ADR-0017) — ISO 6346 size/type codes. Prisma enum values cannot start with a digit, so the
// codes carry a `C` prefix (`C20GP` = 20GP). Additive only.
enum ContainerSizeType {
  C20GP
  C40GP
  C40HC
  C45HC

  @@map("container_size_type")
}

// M9 (ADR-0017) — one physical container of a shipment. Tenant table (RLS in migration 0010).
// `containerNumber` is validated in code (ISO 6346 check digit) and by a format CHECK in the DB.
model Container {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  shipmentId      String             @map("shipment_id") @db.Uuid
  containerNumber String             @map("container_number") // ISO 6346, upper case, no spaces
  sizeType        ContainerSizeType? @map("size_type")
  vesselImo       String?            @map("vessel_imo") // set by LOADED_ON_VESSEL; logically references active_vessels(imo), no FK (shared table, see README)
  vesselName      String?            @map("vessel_name")
  voyageNumber    String?            @map("voyage_number")
  providerRef     String?            @map("provider_ref") // provider's container id, if it issues one
  lastMilestone   String?            @map("last_milestone") // normalised milestone name (adapters `Milestone`)
  lastMilestoneAt DateTime?          @map("last_milestone_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id])
  // Composite FK: a container can only belong to its own tenant's shipment.
  shipment     Shipment        @relation(fields: [shipmentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  events       ShipmentEvent[]

  @@unique([organizationId, containerNumber, shipmentId])
  @@unique([id, organizationId]) // target of the composite FK from shipment_events
  @@index([organizationId])
  @@index([containerNumber]) // M9: cross-tenant webhook lookup by number (SECURITY DEFINER function, migration 0010)
  @@index([shipmentId])
  @@map("containers")
}

enum DocumentType {
  COMMERCIAL_INVOICE
  PACKING_LIST
  BILL_OF_LADING
  AIRWAY_BILL
  CERTIFICATE_OF_ORIGIN
  INSURANCE_CERT
  OTHER
  // (NEW vs brief, M5) organisation-level records (docs/phase-1-workspace-ux.md "Organisation documents"). Additive only.
  EORI_CONFIRMATION
  VAT_CERTIFICATE
  REPRESENTATION_AUTHORITY

  @@map("document_type")
}

enum DocumentStatus {
  UPLOADED
  SCANNING
  CLEAN
  REJECTED
  VERIFIED

  @@map("document_status")
}

// (NEW vs brief, M5) What a document is attached to. Phase 1 has no shipments yet, so uploads hang
// off an accepted quote (QUOTE) or the organisation itself (ORGANISATION: EORI confirmation, VAT
// certificate, representation authority); SHIPMENT is Phase 2. Migration 0005 adds a CHECK so the
// scope agrees with which of quote_id / shipment_id is set. Additive only.
enum DocumentScope {
  SHIPMENT
  QUOTE
  ORGANISATION

  @@map("document_scope")
}

model Document {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  shipmentId     String?        @map("shipment_id") @db.Uuid
  quoteId        String?        @map("quote_id") @db.Uuid // (NEW vs brief, M5) documents are collected per accepted quote before a shipment exists
  scope          DocumentScope // (NEW vs brief, M5)
  type           DocumentType
  status         DocumentStatus @default(UPLOADED)
  storageKey     String         @map("storage_key") // never a public URL; `orgId/{quote|org}/docId` in Phase 1, `orgId/shipmentId/docId` (§7.4) once shipments exist
  originalName   String         @map("original_name") // sanitised at upload; for display and Content-Disposition only, never a storage path, never logged (§7.3)
  mimeType       String         @map("mime_type")
  sizeBytes      Int            @map("size_bytes") // ≤ 25 MB (§7.4); Int is ample
  sha256         String // '' until the scan pipeline has read the object
  version        Int            @default(1) // same type + target again → version + 1; older rows are kept
  uploadedById   String         @map("uploaded_by_id") @db.Uuid
  verifiedById   String?        @map("verified_by_id") @db.Uuid
  verifiedAt     DateTime?      @map("verified_at")
  // (NEW vs brief, M5) scan pipeline outcome (§7.4). scanEngine 'clamav' | 'none'; scanResult
  // 'clean' | 'not_scanned' | a rejected reason. status stays UPLOADED when no scanner ran.
  scanEngine     String?        @map("scan_engine")
  scanResult     String?        @map("scan_result")
  scannedAt      DateTime?      @map("scanned_at")
  rejectedReason String?        @map("rejected_reason") // (NEW vs brief, M5) set with status REJECTED; the object is deleted from storage
  deletedAt      DateTime?      @map("deleted_at") // (NEW vs brief, M5) soft delete; the object is removed from storage at the same time
  createdAt      DateTime       @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id]) // (NEW vs brief)
  // (NEW vs brief) composite FK: a document can only be attached to its own tenant's shipment.
  shipment     Shipment?    @relation(fields: [shipmentId, organizationId], references: [id, organizationId])
  // (NEW vs brief, M5) composite FK: a document can only be attached to its own tenant's quote. Restrict: delete the documents first.
  quote        Quote?       @relation(fields: [quoteId, organizationId], references: [id, organizationId], onDelete: Restrict)
  uploadedBy   User         @relation("uploadedDocuments", fields: [uploadedById], references: [id]) // (NEW vs brief) who uploaded (audit / UI)
  verifiedBy   User?        @relation("verifiedDocuments", fields: [verifiedById], references: [id]) // (NEW vs brief) who verified

  @@index([organizationId])
  @@index([shipmentId]) // (NEW vs brief) booking preconditions look up docs by shipment (§6.1)
  @@index([organizationId, quoteId]) // (NEW vs brief, M5) vault "by quote" and missing-files list
  @@map("documents")
}

// ---------- Cross-cutting ----------

// Append-only (UPDATE/DELETE rejected by trigger in migration 0002). `metadata` must never
// contain PII (§7.3): IDs only.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String // "quote.accept", "org.eori.update", "doc.download"
  targetType     String   @map("target_type")
  targetId       String   @map("target_id")
  ip             String?
  userAgent      String?  @map("user_agent")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id]) // (NEW vs brief) the brief's Organization.auditLogs needs this inverse side

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// (NEW vs brief) Phase 2 outbox (§6.2): the booking transaction writes the Shipment and an
// outbox row atomically; a worker performs the external call and marks it processed. Designed now
// so Phase 2 needs no migration. NO CODE USES THIS TABLE YET — nothing ships until the forwarder
// partnership is signed (§2). organizationId is nullable for system-level events (e.g. cache
// refresh fan-out); no FK on purpose so an org hard-delete (§7.3) never has to touch the outbox.
model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  kind           String // e.g. "shipment.book", "forwarder.poll"
  payload        Json
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @map("next_attempt_at")
  processedAt    DateTime? @map("processed_at")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([processedAt, nextAttemptAt])
  @@index([organizationId]) // (NEW vs brief) RLS / tenant scoping
  @@map("outbox_events")
}

model TariffCache {
  hsCode        String   @map("hs_code")
  originCountry String   @map("origin_country")
  fetchedAt     DateTime @map("fetched_at")
  expiresAt     DateTime @map("expires_at")
  payload       Json

  @@id([hsCode, originCountry])
  @@map("tariff_cache")
}

model FxRate {
  id        String   @id @default(uuid()) @db.Uuid
  source    String
  currency  String
  rateToGbp Decimal  @map("rate_to_gbp") @db.Decimal(14, 6)
  validFrom DateTime @map("valid_from")
  validTo   DateTime @map("valid_to")

  @@unique([source, currency, validFrom])
  @@index([currency, validFrom]) // (NEW vs brief) FX resolution looks up "latest rate for currency as of date"
  @@map("fx_rates")
}

// ---------- M9 shipment tracking, shared (non-tenant) tables (ADR-0017) ----------

// Polling state of a vessel (ADR-0017 "smart pull"). Additive only.
enum VesselPollState {
  AT_SEA
  COASTAL
  APPROACHING
  DOCKED
  STALE

  @@map("vessel_poll_state")
}

// One row per ship that currently carries a tracked container, whichever organisations own the
// cargo: one AIS poll serves them all. Not tenant-scoped, no RLS. The app role reads it; the
// worker (and the milestone processor) writes it. In this repo both use the `harbour_app` role
// for now — the app/worker role split is a TODO in packages/db README ("0010").
// Coordinates, speed and heading are not money (Decimal columns for exactness, numbers in code).
model ActiveVessel {
  imo                  String          @id // 7 digits, check digit validated in code + CHECK in 0010
  name                 String?
  lastLatitude         Decimal?        @map("last_latitude") @db.Decimal(9, 6)
  lastLongitude        Decimal?        @map("last_longitude") @db.Decimal(9, 6)
  speedKnots           Decimal?        @map("speed_knots") @db.Decimal(5, 1)
  headingDeg           Decimal?        @map("heading_deg") @db.Decimal(5, 1)
  positionAt           DateTime?       @map("position_at") // when the AIS fix was taken (never an extrapolation)
  positionSource       String?         @map("position_source") // PositionProvider.name, e.g. SPIRE
  providerEtaAt        DateTime?       @map("provider_eta_at") // shown as "Carrier ETA"; never computed by us
  destinationLocode    String?         @map("destination_locode") // Port.locode used for the distance-based poll interval
  pollState            VesselPollState @default(AT_SEA) @map("poll_state")
  nextPollAt           DateTime?       @map("next_poll_at") // null = never (DOCKED)
  lastError            String?         @map("last_error") // "<n>:<class>" consecutive-failure counter, no secrets
  activeContainerCount Int             @default(0) @map("active_container_count") // 0 → DOCKED (kill switch)
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  @@index([nextPollAt, pollState]) // the hourly vessel-poll selects `nextPollAt <= now AND pollState <> DOCKED`
  @@map("active_vessels")
}

// Small UN/LOCODE reference table for distance calculations and the origin/destination selects.
// Seeded in migration 0010 (approximate coordinates, ±0.01°, not for navigation). Shared, no RLS.
model Port {
  locode      String  @id // UN/LOCODE, e.g. GBFXT
  name        String
  countryCode String  @map("country_code") // ISO 3166-1 alpha-2
  latitude    Decimal @db.Decimal(9, 6)
  longitude   Decimal @db.Decimal(9, 6)
  chokePoint  Boolean @default(false) @map("choke_point") // transshipment hub / choke point that tightens polling (COASTAL)

  @@map("ports")
}
