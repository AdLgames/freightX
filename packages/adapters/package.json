{
  "name": "@harbour/adapters",
  "version": "0.1.0",
  "private": true,
  "description": "I/O adapters for the engine: UK Trade Tariff, HMRC/ECB FX, freight rate sheet, provider resilience",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tracking/core": {
      "types": "./dist/tracking/core.d.ts",
      "default": "./dist/tracking/core.js"
    },
    "./rate-sheets/v1.json": "./rate-sheets/v1.json",
    "./fixtures/fx/hmrc-monthly-sample.csv": "./fixtures/fx/hmrc-monthly-sample.csv"
  },
  "files": [
    "dist",
    "rate-sheets",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1138.0",
    "@harbour/engine": "workspace:*",
    "decimal.js": "^10.6.0",
    "opossum": "^10.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/opossum": "^8.1.9"
  }
}
