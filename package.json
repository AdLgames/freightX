{
  "name": "harbour",
  "private": true,
  "version": "0.1.0",
  "description": "Landed-cost & import workspace for UK micro-importers (working name: Harbour)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build && pnpm --filter @harbour/web run build",
    "dev": "pnpm --filter @harbour/web run dev",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @harbour/db run generate",
    "db:migrate": "pnpm --filter @harbour/db run migrate:deploy",
    "audit:ci": "pnpm audit --audit-level=high --prod"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
