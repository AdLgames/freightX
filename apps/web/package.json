{
  "name": "@harbour/web",
  "version": "0.1.0",
  "private": true,
  "description": "Harbour web app: Phase 0 public landed-cost calculator (React Router 7 framework mode)",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "vercel-build": "pnpm --filter @harbour/engine --filter @harbour/adapters --filter @harbour/db run build && react-router build"
  },
  "dependencies": {
    "@harbour/adapters": "workspace:*",
    "@harbour/db": "workspace:*",
    "@harbour/engine": "workspace:*",
    "@mjackson/form-data-parser": "^0.9.1",
    "@react-router/node": "~7.18.4",
    "@react-router/serve": "~7.18.4",
    "@vercel/react-router": "^1.3.6",
    "bullmq": "^5.81.5",
    "decimal.js": "^10.6.0",
    "ioredis": "^5.11.1",
    "isbot": "^5.2.2",
    "lucide-react": "^1.47.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "~7.18.4",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@react-router/dev": "~7.18.4",
    "@react-router/fs-routes": "~7.18.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "vite": "^7.3.6"
  }
}
