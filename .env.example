# Harbour — local environment template. Copy to .env (git-ignored). Never commit real values (§7.6).
# All variables are optional for the public calculator, which runs with none of them set. The
# signed-in workspace (Phase 1) needs DATABASE_URL, and in production also REDIS_URL, APP_URL and
# an email transport (see apps/web/README.md, "Workspace (M1)").

# ---- apps/web ----
NODE_ENV=development
# debug | info | warn | error (default: debug in development, info in production)
LOG_LEVEL=debug

# Postgres. Unset → in-memory tariff cache, FX store and signup list (see apps/web/app/services/db.server.ts).
# See packages/db/.env.example for the RLS-aware connection details.
DATABASE_URL=

# Redis for the shared token-bucket rate limiter AND the workspace session store (one connection).
# Unset → per-process in-memory limiter and sessions (development/test only). In production the
# workspace refuses to run without it (503 "Workspace temporarily unavailable"); the calculator is unaffected.
REDIS_URL=

# Cloudflare Turnstile for the public calculator (§7.5). Unset secret → bot check OFF (dev only).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Path to an HMRC monthly exchange-rate CSV to seed the FX store at startup.
# Unset → packages/adapters/fixtures/fx/hmrc-monthly-sample.csv is loaded with a loud SAMPLE warning.
FX_SEED_CSV=

# Path to a freight rate sheet JSON. Unset → packages/adapters/rate-sheets/v1.json (resolved via the package).
RATE_SHEET_PATH=

# UK Trade Tariff API key. Set BOTH or NEITHER (startup fails on only one). Unset → anonymous calls.
# TRADE_TARIFF_API_KEY_HEADER must be confirmed from the Trade Tariff developer portal before use
# (do not guess it). The key is sent only in that request header and is never logged.
TRADE_TARIFF_API_KEY=
TRADE_TARIFF_API_KEY_HEADER=

# Default broker (forwarder) deferment fee terms prefilled in the calculator, as decimal strings:
# a percentage of the duty + VAT the forwarder advances ("2.5" means 2.5%) and a minimum fee in GBP.
# Unset → NO default fee; the calculator says fee terms depend on the forwarder. Use real terms only.
BROKER_DEFERMENT_FEE_PCT=
BROKER_DEFERMENT_MIN_GBP=

# Estimated UK inland costs (GBP) added to the import VAT base, by mode, ONLY when the freight
# source did not give the UK post-border leg (the rate sheet always does, so this affects fallback
# providers only). Not a landed cost. No defaults: set only once a figure has been verified.
INLAND_VAT_ADJUSTMENT_LCL_GBP=
INLAND_VAT_ADJUSTMENT_FCL_GBP=
INLAND_VAT_ADJUSTMENT_AIR_GBP=

# ---- workspace sign-in (M1) ----
# Public origin of the app, e.g. https://app.example.co.uk (no path). Used to build magic links and
# as the expected Origin of workspace POSTs. Required for sign-in in production (never derived from
# the Host header there); in development/test the request's own origin is used when unset.
APP_URL=
# Transactional email for magic links: console | resend.
# console → logs the link path (development/test only; refused in production).
# resend  → https://api.resend.com/emails with RESEND_API_KEY and EMAIL_FROM.
# Unset → console outside production; in production sign-in shows "not available yet" (fail closed).
EMAIL_TRANSPORT=
RESEND_API_KEY=
# Sender, e.g. Harbour <sign-in@example.co.uk> (the domain must be verified with the provider).
EMAIL_FROM=

# Unused: session ids are random and stored server-side, so cookies are not signed. Validated
# (≥ 32 characters) only if set.
SESSION_SECRET=

# ---- billing (M6) ----
# Stripe Billing. All optional: unset → /app/settings/billing says "Billing is not configured" and
# nothing else changes. Plan names and prices live in Stripe; the two price ids are the only link
# between a Stripe price and the Plan enum. Secrets are never logged (see apps/web/README.md, "Billing (M6)").
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (Dashboard, or `stripe listen` prints one). Without it
# POST /webhooks/stripe answers 503 so Stripe keeps retrying.
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# ---- apps/worker ----
# Who consumes the `stripe-events` queue: web (default; the web app both enqueues and processes) or
# worker (needs a database-backed handler in apps/worker — not wired yet).
STRIPE_EVENTS_CONSUMER=
# ---- document vault (M5) ----
# S3-compatible object storage (Cloudflare R2 or AWS S3; private bucket, presigned URLs only, §7.4).
# Set BUCKET + ACCESS_KEY_ID + SECRET_ACCESS_KEY (+ ENDPOINT for R2/MinIO; REGION defaults to `auto`
# with an endpoint, else required, e.g. eu-west-2). All unset outside production → files are kept in
# STORAGE_LOCAL_DIR with app-signed URLs (/files/put/*, /files/get/*). Production without S3 → the
# Documents section says "Document storage not configured"; everything else keeps working.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# true|false; default: path-style when STORAGE_ENDPOINT is set (R2), virtual-hosted on AWS.
STORAGE_FORCE_PATH_STYLE=
# Local backend only (development): directory (default .data/storage, git-ignored) and the HMAC
# secret for its signed URLs (default: derived from SESSION_SECRET, else a fixed dev secret).
STORAGE_LOCAL_DIR=
STORAGE_LOCAL_SECRET=
# ClamAV daemon (INSTREAM over TCP). Unset → uploads get a type and size check only, are marked
# "not scanned" and stay "Uploaded" — never "Clean". Shared with apps/worker.
CLAMD_HOST=
CLAMD_PORT=3310
